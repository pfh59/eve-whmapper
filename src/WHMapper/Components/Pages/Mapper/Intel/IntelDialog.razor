@using WHMapper.Models.DTO.Intel

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Radar" />
            <MudText Typo="Typo.h6">Intel — @SystemName</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <div class="whm-intel">
            @if (_loading || _report == null)
            {
                <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Class="pa-6">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2">Loading zKillboard activity…</MudText>
                </MudStack>
            }
            else
            {
                @switch (_report.Status)
                {
                    case WHIntelStatus.Unauthorized:
                        <MudAlert Severity="Severity.Error">You are not allowed to view the intel of this map.</MudAlert>
                        break;

                    case WHIntelStatus.Unavailable:
                        <MudAlert Severity="Severity.Warning">zKillboard is unavailable or rate limited the request. Try again later.</MudAlert>
                        break;

                    case WHIntelStatus.NoActivity:
                        <MudAlert Severity="Severity.Info">No recorded activity on zKillboard.</MudAlert>
                        break;

                    default:
                        @RenderReport(_report)
                        break;
                }
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error" OnClick="Close">Close</MudButton>
        <MudButton Color="Color.Success" Href="@ZKillboardSystemUrl" Target="_blank" StartIcon="@Icons.Material.Filled.OpenInNew">zKillboard</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private RenderFragment RenderReport(WHIntelReport report) => __builder =>
    {
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">
            <MudTabPanel Text="Analysis" Icon="@Icons.Material.Filled.Insights">
                @RenderAnalysis(report)
            </MudTabPanel>
            <MudTabPanel Text="@($"Recent kills ({report.RecentKills.Count})")" Icon="@Icons.Material.Filled.FormatListBulleted">
                @RenderRecentKills(report)
            </MudTabPanel>
            <MudTabPanel Text="Top 10" Icon="@Icons.Material.Filled.Leaderboard">
                <MudGrid Spacing="2" Class="mt-1">
                    <MudItem xs="12" md="4">@RenderTopList("Characters", report.TopLists.Characters)</MudItem>
                    <MudItem xs="12" md="4">@RenderTopList("Corporations", report.TopLists.Corporations)</MudItem>
                    <MudItem xs="12" md="4">@RenderTopList("Alliances", report.TopLists.Alliances)</MudItem>
                </MudGrid>
            </MudTabPanel>
        </MudTabs>
    };

    private RenderFragment RenderAnalysis(WHIntelReport report) => __builder =>
    {
        var analysis = report.Analysis;
        if (analysis == null)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">Not enough data: at least @MIN_KILLS_FOR_ANALYSIS kills are needed for an analysis.</MudAlert>
            return;
        }

        <MudGrid Spacing="2" Class="mt-1">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1" Class="whm-intel-section">Activity profile</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudChip T="string" Color="@GetProfileColor(analysis.Profile)">@analysis.Profile</MudChip>
                    <MudText Typo="Typo.body2">
                        NPC kills @FormatPercent(analysis.NpcKillShare) · Solo kills @FormatPercent(analysis.SoloKillShare) · @analysis.KillCount kills analysed
                    </MudText>
                </MudStack>

                <MudText Typo="Typo.subtitle1" Class="mt-4 whm-intel-section">Active timezone</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudChip T="string" Color="Color.Info">@FormatTimezone(analysis.Timezone)</MudChip>
                    <MudText Typo="Typo.body2">@TIMEZONE_WINDOWS_HINT</MudText>
                </MudStack>

                <MudText Typo="Typo.subtitle1" Class="mt-4 whm-intel-section">Kills per hour (UTC)</MudText>
                <MudText Typo="Typo.body2">
                    Number of kills recorded at each hour of the day, over the @analysis.KillCount kills analysed. The highest bars show when the system is most active.
                </MudText>
                <MudChart T="double" ChartType="ChartType.Bar" ChartLabels="@HOUR_LABELS" ChartSeries="@_hourlySeries"
                          ChartOptions="@_hourlyChartOptions" Width="100%" Height="260px" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle1" Class="whm-intel-section">Probable residents</MudText>
                <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                    <thead>
                        <tr><th>Corporation</th><th>Structures lost</th><th>Ships lost</th><th>Kills</th><th>Days</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var resident in analysis.Residents)
                        {
                            <tr>
                                <td>
                                    @report.GetName(resident.CorporationId)
                                    @if (resident.AllianceId.HasValue)
                                    {
                                        <MudText Typo="Typo.caption" Class="d-block">@report.GetName(resident.AllianceId)</MudText>
                                    }
                                </td>
                                <td>@resident.StructureLosses</td>
                                <td>@resident.ShipLosses</td>
                                <td>@resident.Kills</td>
                                <td>@resident.ActiveDays</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                <MudText Typo="Typo.subtitle1" Class="mt-4 whm-intel-section">
                    Likely fleet composition (@(analysis.FleetFromResidents ? "residents" : "all player attackers"))
                </MudText>
                @if (analysis.FleetHulls.Count == 0)
                {
                    <MudText Typo="Typo.body2">No player attacker recorded.</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                        <thead>
                            <tr><th>Hull</th><th>Group</th><th>Pilots</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var hull in analysis.FleetHulls)
                            {
                                <tr>
                                    <td>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudImage Src="@GetShipIconUrl(hull.ShipTypeId)" Width="24" Height="24" />
                                            @report.GetName(hull.ShipTypeId)
                                        </MudStack>
                                    </td>
                                    <td>@report.GetShipGroupName(hull.ShipTypeId)</td>
                                    <td>@hull.Count</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                    <MudText Typo="Typo.caption">Average gang size: @analysis.AverageGangSize.ToString("0.#")</MudText>
                }
            </MudItem>
        </MudGrid>
    };

    private RenderFragment RenderRecentKills(WHIntelReport report) => __builder =>
    {
        <MudTable T="WHIntelKill" Items="@report.RecentKills" Dense="true" Hover="true" Elevation="0" FixedHeader="true" Height="420px">
            <HeaderContent>
                <MudTh>Date (UTC)</MudTh>
                <MudTh>Ship</MudTh>
                <MudTh>Victim</MudTh>
                <MudTh>Attackers</MudTh>
                <MudTh>Final blow</MudTh>
                <MudTh>Value</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.KillTimeUtc.ToString("yyyy-MM-dd HH:mm")</MudTd>
                <MudTd>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudImage Src="@GetShipIconUrl(context.VictimShipTypeId)" Width="24" Height="24" />
                        @report.GetName(context.VictimShipTypeId)
                    </MudStack>
                </MudTd>
                <MudTd>
                    @report.GetName(context.VictimCharacterId)
                    <MudText Typo="Typo.caption" Class="d-block">
                        @report.GetName(context.VictimCorporationId)@(context.VictimAllianceId.HasValue ? $" / {report.GetName(context.VictimAllianceId)}" : string.Empty)
                    </MudText>
                </MudTd>
                <MudTd>@context.AttackerCount</MudTd>
                <MudTd>@report.GetName(context.FinalBlowCorporationId)</MudTd>
                <MudTd>@FormatIsk(context.TotalValue)</MudTd>
                <MudTd>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        @if (context.IsNpc)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">NPC</MudChip>
                        }
                        @if (context.IsSolo)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">Solo</MudChip>
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Color="Color.Success" Href="@context.ZKillboardUrl" Target="_blank" aria-label="Open on zKillboard" />
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>
    };

    private RenderFragment RenderTopList(string title, IReadOnlyList<WHIntelTopEntry> entries) => __builder =>
    {
        <MudText Typo="Typo.subtitle1" Class="whm-intel-section">Top @title</MudText>
        @if (entries.Count == 0)
        {
            <MudText Typo="Typo.body2">No data.</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Elevation="0">
                <thead>
                    <tr><th>#</th><th>Name</th><th>Kills</th></tr>
                </thead>
                <tbody>
                    @foreach (var entry in entries)
                    {
                        <tr><td>@entry.Rank</td><td>@entry.Name</td><td>@entry.Kills</td></tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    };
}
