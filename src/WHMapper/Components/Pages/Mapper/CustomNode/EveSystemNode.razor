@using Blazor.Diagrams.Components.Renderers;
@using WHMapper.Models.Custom.Node;
@using WHMapper.Models.DTO.EveMapper.Enums;


<MudPaper Outlined="true" Style="@systemStyle">

    <MudStack Row="false" Spacing="0" Style="height:100%;" Justify="Justify.SpaceBetween">

        @* --- HEADER : badge à gauche / lock + effet à droite --- *@
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="0" Class="mt-2 ml-2 mr-2">
            <MudBadge Origin="Origin.TopRight" Overlap="true"
                      Content=@Node.NameExtension
                      Visible=@(Node.NameExtension!=null)
                      Bordered="true" Color="Color.Dark">
                <MudAvatar Style="@($"color:{_systemColor}; border-color:{_systemColor}; font-weight:bold;")"
                           Size="Size.Small" Variant="Variant.Outlined" Class="mt-1">
                    @Node.SystemType.ToDescriptionString()
                </MudAvatar>
            </MudBadge>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="0">
                @if (Locked)
                {
                    <MudIcon Icon="@Icons.Material.Sharp.Lock" Size="Size.Small" />
                }
                @if (Node != null && Node.Effect != WHMapper.Models.DTO.EveMapper.Enums.WHEffect.None)
                {
                    <MudTooltip Text="@Node.Effect.ToString()" Arrow="true" Placement="Placement.Bottom">
                        <ChildContent>
                            <MudIcon Icon="@Icons.Material.Filled.Square" Style="@($"color:{_whEffectColor};")" Size="Size.Small"/>
                        </ChildContent>
                        <TooltipContent>
                            <MudPaper Class="d-flex flex-column flex-grow-1 gap-0 px-2 py-1" Elevation="0">
                                <MudText Align="Align.Center" Typo="Typo.subtitle2">@Node.Effect.ToString()</MudText>
                                @if (Node != null && Node.EffectDetails!=null)
                                {
                                    foreach (Models.DTO.EveMapper.EveSystemEffect effectInfo in Node.EffectDetails)
                                    {
                                        <MudText Align="Align.Left" Typo="Typo.caption">@effectInfo.Name. : @effectInfo.Value%</MudText>
                                    }
                                }
                            </MudPaper>
                        </TooltipContent>
                    </MudTooltip>
                }
            </MudStack>
        </MudStack>

        @* --- CENTRE : nom / édition, largeur 100 % --- *@
        <MudStack Row="true" Style="width:100%;" Spacing="0" Class="ml-2 mr-2">
            @if (_isEditingName)
            {
                <MudTextField @bind-Value="_editedName" Typo="Typo.body2" Align="Align.Center"
                              Immediate="true"
                              @onblur="@(() => SaveName())"
                              @onkeyup="@((e) => OnKeyUp(e))"
                              Style="font-weight:bold; width:99%;"
                              Variant="Variant.Text"
                              Margin="Margin.Dense"
                              AutoFocus="true" />
            }
            else
            {
                @if(Node.AlternateName!=null)
                {
                    <MudText Typo="Typo.body2" Align="Align.Center"
                             Style="font-weight:bold; width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                             @ondblclick="StartEditingName">@Node.AlternateName</MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2" Align="Align.Center"
                             Style="font-weight:bold; width:100%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                             @ondblclick="StartEditingName">@Node.Name</MudText>
                }
            }
        </MudStack>

        @* --- FOOTER : users connectés / statiques --- *@
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="0" class="mb-2 ml-2 mr-2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                @if (Node != null && Node.ConnectedUsers != null && Node.ConnectedUsers.FirstOrDefault() != null)
                {
                    <MudTooltip Arrow="true" Placement="Placement.Bottom">
                        <ChildContent>
                            <MudIcon Icon="@Icons.Material.Filled.Group" Color=Color.Default Size="Size.Small" />
                        </ChildContent>
                        <TooltipContent>
                            <MudPaper Class="d-flex flex-column flex-grow-1 gap-0" Elevation="0">
                                @foreach (var user in @Node.ConnectedUsers)
                                {
                                    <MudText class="ml-1 mr-1" Typo="Typo.caption" Style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@user</MudText>
                                }
                            </MudPaper>
                        </TooltipContent>
                    </MudTooltip>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Group" Color=Color.Transparent Size="Size.Small" />
                }
                <MudText Typo="Typo.caption">@Node?.ConnectedUsers?.FirstOrDefault()</MudText>
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                @if (Node != null && Node.Statics != null && Node?.Statics.Count() > 0)
                {
                    @foreach (var item in Node.Statics)
                    {
                        <MudText Typo="Typo.body2" Style="@($"color:{WHColorHelper.GetSystemTypeColor(@item.Destination)};")">@item.Destination.ToString()</MudText>
                    }
                }
            </MudStack>
        </MudStack>

    </MudStack>
</MudPaper>
